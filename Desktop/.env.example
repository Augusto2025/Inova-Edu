# Inova Edu Desktop - Environment Variables Template
# Copie este arquivo para .env e preencha com suas credenciais reais
# NUNCA commite o arquivo .env real no controle de versão!

# Cloudinary - Armazenamento de imagens de perfil
CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=sua_api_secret

# PostgreSQL - Configuração do banco de dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inova_edu
DB_USER=seu_usuario
DB_PASSWORD=sua_senha

# Opcional: Chave secreta para assinatura de tokens (se implementado)
# SECRET_KEY=gere_uma_chave_secreta_segura